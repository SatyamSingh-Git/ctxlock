{
  "name": "ctxlock",
  "version": "0.0.0",
  "description": "CI for AI agent context. Lints AGENTS.md, CLAUDE.md, skills and rules against what each agent actually loads, flags unsafe changes in pull requests, and checks Claude Code's behavior, base vs head.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "context-engineering",
    "agents-md",
    "claude-md",
    "claude-code",
    "codex",
    "agent-skills",
    "mcp",
    "github-actions",
    "continuous-integration",
    "linter",
    "llm-evaluation",
    "ai-security"
  ],
  "author": "Satyam Singh",
  "homepage": "https://github.com/SatyamSingh-Git/ctxlock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SatyamSingh-Git/ctxlock.git"
  },
  "bugs": {
    "url": "https://github.com/SatyamSingh-Git/ctxlock/issues"
  },
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ctxlock": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ignore": "^7.0.14",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^15.0.3",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
